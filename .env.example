# ============================================================================
# HOS-BACKOFFICE — environment template (copy to .env before `docker compose up`)
# DO NOT commit .env — secrets come from K8s Secrets / Vault in production.
# ============================================================================

# --- App --------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local demo mode: JSON persistent store (works WITHOUT Docker / PostgreSQL)
STORE_FILE=.data/live-store.json

# --- PostgreSQL 15 (postgres:15-alpine, 5432:5432) --------------------------
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=hos_backoffice
PG_USER=hos_admin
PG_PASSWORD=hos_secret_2560
# Unset DATABASE_URL => store runs in file mode (fallback, no Docker required)
DATABASE_URL=postgres://hos_admin:hos_secret_2560@postgres:5432/hos_backoffice

# --- Redis 7 (redis:7-alpine, 6379:6379, AOF) -------------------------------
REDIS_URL=redis://redis:6379/0

# --- MinIO (object storage, WORM / Object Lock for COA / cold-chain / PAdES) --
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=hos_admin
MINIO_SECRET_KEY=hos_minio_secret_2560
MINIO_BUCKET_AUDIT=hos-audit-worm
MINIO_CONSOLE=http://localhost:9001

# --- MOPH Provider ID — OIDC PKCE (RS256 / ES256 only) ----------------------
HOSPITAL_HCODE=10670
MOPH_ISSUER=https://id.moph.go.th
MOPH_AUTH_URL=https://id.moph.go.th/oauth2/authorize
MOPH_TOKEN_URL=https://id.moph.go.th/oauth2/token
MOPH_JWKS_URL=https://id.moph.go.th/oauth2/jwks
MOPH_CLIENT_ID=hos-backoffice
MOPH_CLIENT_SECRET=__set_in_vault__
MOPH_REDIRECT_URI=http://localhost:3000/api/auth/moph-provider-callback

# --- Penalty / standstill (canonical — do not change without spec review) ---
PENALTY_DAILY_RATE=0.005
PENALTY_CAP=0.10
STANDSTILL_WORKING_DAYS=7
